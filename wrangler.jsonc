{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2cfcbf71-ce57-445a-9d01-03c49ec444bb","database_name": "web-appa" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "45b8906081f84ce388c09362701cc482" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
